
<h1 class="text-3xl font-bold text-center my-8">
  Ideas
</h1>

<div data-controller="modal">

  <!-- Button to open modal -->
  <button data-modal-target="default-modal"
          data-modal-toggle="default-modal"
          class="block mx-auto text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center"
          type="button">
    Add New Idea
  </button>

  <!-- Modal -->
  <div id="default-modal"
       tabindex="-1"
       aria-hidden="true"
       class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-start w-full md:inset-0 h-full max-h-full">

    <div class="relative p-4 w-full max-w-2xl max-h-full overflow-y-auto">
      <div class="relative bg-white rounded-lg shadow">

        <%= simple_form_for Idea.new, data: { action: "submit->modal#hideModal" } do |f| %>

          <div class="flex items-center justify-between p-4 md:p-5 border-b rounded-t">
            <h3 class="text-xl font-semibold text-gray-900">
              Add New Idea
            </h3>

            <button type="button"
                    class="text-gray-400 bg-transparent hover:bg-gray-200 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center"
                    data-modal-hide="default-modal">
              <span class="sr-only">Close modal</span>
              X
            </button>
          </div>

          <div class="p-4 md:p-5 space-y-4">
            <%= f.input :description, input_html: { rows: 5, class: 'text-gray-800' } %>
            <%= f.input :author, input_html: { class: 'text-gray-800' } %>
          </div>

          <div class="flex items-center p-4 md:p-5 border-t border-gray-200 rounded-b">
            <%= f.submit 'Submit', class: 'text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 me-2 mb-2' %>

            <button data-modal-hide="default-modal"
                    type="button"
                    class="text-white bg-red-700 hover:bg-red-800 font-medium rounded-lg text-sm px-5 py-2.5">
              Cancel
            </button>
          </div>

        <% end %>

      </div>
    </div>
  </div>
</div>

<!-- Display existing ideas -->
<div class="max-w-screen-xl mx-auto mt-8">
  <% @ideas.each do |idea| %>
    <div class="rounded overflow-hidden shadow-lg mb-6">
      <div class="px-6 py-8 h-full">

        <div class="font-bold text-xl mb-2">
          <%= idea.description %>
        </div>

        <p class="text-sm text-gray-700">
          <%= idea.author %>
        </p>

        <!-- Delete and Revise buttons -->
        <div class="flex mt-4">

          <%= button_to "Delete", idea_path(idea),
              method: :delete,
              data: { turbo_confirm: "Are you sure?" },
              class: "text-white bg-red-700 hover:bg-red-800 focus:ring-4 focus:ring-red-300 font-medium rounded-lg text-sm px-5 py-2.5 me-2 mb-2" %>

          <%= link_to "Revise", edit_idea_path(idea),
              class: "text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 me-2 mb-2" %>

        </div>

      </div>
    </div>
  <% end %>
  <div class="mt-5">
  <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
</div>
</div>
